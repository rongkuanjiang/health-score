# Add these in Vercel Project Settings > Environment Variables; redeploy afterward.
# No .env loader is used by the standard-library local server.
SCORER_MODE=demo
# Comma-separated exact custom/project aliases, without https:// or trailing /.
# VERCEL_URL, VERCEL_BRANCH_URL and VERCEL_PROJECT_PRODUCTION_URL are also allowed.
SCORER_ALLOWED_HOSTS=
# Optional HTTPS parent origins for iframe embedding. Blank blocks iframes.
SCORER_FRAME_ANCESTORS=
# For server-to-server API mode only: SCORER_MODE=api and a random 32+ character key.
# Keep the key on the app backend, never in HTML, mobile app bundles or Git.
SCORER_API_KEY=
