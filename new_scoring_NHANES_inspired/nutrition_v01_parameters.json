{
  "model_version": "nutrition-v0.1-provisional",
  "implementation_status": "engine_implemented",
  "source_review_date": "2026-09-24",
  "domain_label": "Nutrition markers",
  "domain_score_enabled": false,
  "domain_aggregation_status": "limited_marker_coverage",
  "point_design": "Unvalidated display choices, not overall nutrition, diet quality or disease probability",
  "minimum_point_age": 18,
  "older_age_notice_threshold": 85,
  "eligible_pregnancy_statuses": ["not_pregnant", "not_applicable"],
  "requires_observation_id": true,
  "requires_report_id": true,
  "requires_collection_date": true,
  "requires_evaluation_date": true,
  "multiple_observations_policy": "explicit_selection_required_no_averaging",
  "sole_observation_selection": "automatic_allowed",
  "fasting_required": false,
  "vitamin_d": {
    "label": "Vitamin D marker score (experimental)",
    "required_analyte": "total_25_hydroxyvitamin_d",
    "supported_specimen_types": ["serum", "plasma"],
    "canonical_unit": "nmol/L",
    "unit_multipliers": {"nmol/L": 1, "ng/mL": 2.5},
    "exact_values_must_be_positive": true,
    "anchors": [[0, 0], [30, 50], [50, 100], [125, 100]],
    "zero_anchor_is_limit_only": true,
    "interpolation": "linear",
    "maximum_scored_nmol_l_inclusive": 125,
    "above_maximum": "withhold_not_zero",
    "supported_qualifiers": ["=", "<", "<=", ">", ">="],
    "bound_policy": "withhold_all_nonexact_results_preserve_qualifier",
    "bound_notice_policy": "only_when_entire_interval_in_one_reference_band_otherwise_indeterminate",
    "score_envelopes_enabled": false,
    "reference_notices_require_adult_and_eligible_pregnancy_status": true,
    "reference_bands": [
      {"minimum": 0, "minimum_inclusive": false, "maximum": 30, "maximum_inclusive": false, "notice": "below_reference_band"},
      {"minimum": 30, "minimum_inclusive": true, "maximum": 50, "maximum_inclusive": false, "notice": "possible_inadequacy_band"},
      {"minimum": 50, "minimum_inclusive": true, "maximum": 125, "maximum_inclusive": true, "notice": "reference_adequacy_band"},
      {"minimum": 125, "minimum_inclusive": false, "maximum": null, "notice": "above_scoring_range_review"}
    ],
    "unknown_reliability": "notice",
    "unreliable_result": "withhold"
  },
  "context_only": ["b12", "serum_folate", "rbc_folate", "ferritin", "iron", "transferrin", "tibc", "transferrin_saturation", "albumin", "prealbumin", "total_protein", "hemoglobin", "mcv", "rdw", "other_cbc", "calcium", "magnesium", "other_chemistry"],
  "context_unit_policy": "preserve_original_no_automatic_conversion",
  "supplement_treatment_or_condition_context": "notice_without_point_adjustment_present_or_unknown",
  "always_required_notices": ["limited_nutrition_coverage", "provisional_points"],
  "coverage_percentage_enabled": false,
  "display_decimal_places": 1,
  "display_rounding": "half_up",
  "research_adapter_only": {
    "nhanes_inventory_candidate": "2005-2006 VID_D.LBDVIDMS",
    "inventory_unit": "nmol/L",
    "codebook_verification_status": "verified_2026-09-24_see_nutrition_v01_evaluation",
    "missing_context_policy": "preserve_missing_separate_numerical_diagnostics"
  }
}
