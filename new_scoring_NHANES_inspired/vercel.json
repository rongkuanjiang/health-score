{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{dist/**,nhanes_inventory/**,__pycache__/**,**/__pycache__/**,test_*,evaluate_*,export_*,*.md,integration_examples/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
